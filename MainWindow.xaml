<Window x:Class="FeatherWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="featherWIN" Height="800" Width="1200" MinWidth="480" MinHeight="320"
        KeyDown="Window_KeyDown">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="6">
      <Button x:Name="BackButton" Content="◀" Width="34" ToolTip="Back" Click="Back_Click"/>
      <Button x:Name="ForwardButton" Content="▶" Width="34" ToolTip="Forward" Click="Forward_Click"/>
      <Button x:Name="ReloadButton" Content="⟳" Width="34" ToolTip="Reload (F5)" Click="Reload_Click"/>
      <Button x:Name="NewTabButton" Content="+" Width="34" ToolTip="New tab (Ctrl+T)" Click="NewTab_Click" DockPanel.Dock="Right"/>
      <CheckBox x:Name="ShieldsBox" Content="Block ads" IsChecked="True" Margin="8,0,0,0" VerticalAlignment="Center"
                ToolTip="Block ads and trackers (Shields)" Checked="Shields_Changed" Unchecked="Shields_Changed"
                DockPanel.Dock="Right"/>
      <TextBox x:Name="AddressBox" Margin="6,0" VerticalContentAlignment="Center" FontSize="14"
               ToolTip="Search or enter an address (Ctrl+L)" KeyDown="AddressBox_KeyDown"/>
    </DockPanel>
    <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged"/>
  </DockPanel>
</Window>
